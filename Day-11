// Sudoku Solver

// Changes : int has been changed to char in the array

public class SudokuLeetcode {
        public static void main(String[] args) {
            char[][] board = {
                    {'5', '3', '.', '.', '7', '.', '.', '.', '.'},
                    {'6', '.', '.', '1', '9', '5', '.', '.', '.'},
                    {'.', '9', '8', '.', '.', '.', '.', '6', '.'},
                    {'8', '.', '.', '.', '6', '.', '.', '.', '3'},
                    {'4', '.', '.', '8', '.', '3', '.', '.', '1'},
                    {'7', '.', '.', '.', '2', '.', '.', '.', '6'},
                    {'.', '6', '.', '.', '.', '.', '2', '8', '.'},
                    {'.', '.', '.', '4', '1', '9', '.', '.', '5'},
                    {'.', '.', '.', '.', '8', '.', '.', '7', '9'}
            };

            if (solve(board)) {
                display(board);
            } else {
                System.out.println("Invalid");
            }
        }

        static boolean solve(char[][] board) {
            int n = board.length;
            int r = -1;
            int c = -1;

            boolean emptyLeft = true;

            for (int i = 0; i < n; i++) {
                for (int j = 0; j < n; j++) {
                    if (board[i][j] == '.') {
                        r = i;
                        c = j;
                        emptyLeft = false;
                        break;
                    }
                }
                if (!emptyLeft) {
                    break;
                }
            }

            if (emptyLeft) {
                return true;
            }

            // backtrack
            for (char num = '1'; num <= '9'; num++) { // char so ' 3 '
                if (isSafe(board, r, c, num)) {
                    board[r][c] = num;
                    if (solve(board)) {
                        return true;
                    } else {
                        board[r][c] = '.';
                    }
                }
            }
            return false;
        }

        static boolean isSafe(char[][] board, int r, int c, char num) {
            // check row
            for (int i = 0; i < board.length; i++) {
                if (board[r][i] == num) {
                    return false;
                }
            }

            // check col
            for (int i = 0; i < board.length; i++) {
                if (board[i][c] == num) {
                    return false;
                }
            }

            // check 3x3 sub-box
            int sqrt = (int) Math.sqrt(board.length);
            int rStart = r - r % sqrt;
            int cStart = c - c % sqrt;

            for (int i = rStart; i < rStart + sqrt; i++) {
                for (int j = cStart; j < cStart + sqrt; j++) {
                    if (board[i][j] == num) {
                        return false;
                    }
                }
            }

            return true;
        }

        static void display(char[][] board) {
            for (char[] row : board) {
                for (char num : row) {
                    System.out.print(num + " ");
                }
                System.out.println();
            }
        }
}

// valid sudoku

public class ValidSudoku {
    public static void main(String[] args) {
        char[][] board = {
                {'8', '3', '.', '.', '7', '.', '.', '.', '.'},
                {'6', '.', '.', '1', '9', '5', '.', '.', '.'},
                {'.', '9', '8', '.', '.', '.', '.', '6', '.'},
                {'8', '.', '.', '.', '6', '.', '.', '.', '3'},
                {'4', '.', '.', '8', '.', '3', '.', '.', '1'},
                {'7', '.', '.', '.', '2', '.', '.', '.', '6'},
                {'.', '6', '.', '.', '.', '.', '2', '8', '.'},
                {'.', '.', '.', '4', '1', '9', '.', '.', '5'},
                {'.', '.', '.', '.', '8', '.', '.', '7', '9'}
        };
        System.out.println(solveSudoku(board));
    }
    public static boolean solveSudoku(char[][] board) {
        if (!isValidSudoku(board)) {
            return false;
        }
        return true;
        //return solve(board);
    }
    static boolean isSafe(char[][] board, int r, int c, char num) {
        // check row
        for (int i = 0; i < board.length; i++) {
            if (board[r][i] == num) {
                return false;
            }
        }
        // check col
        for (int i = 0; i < board.length; i++) {
            if (board[i][c] == num) {
                return false;
            }
        }
        // check 3x3 sub-box
        int sqrt = (int) Math.sqrt(board.length);
        int rStart = r - r % sqrt;
        int cStart = c - c % sqrt;

        for (int i = rStart; i < rStart + sqrt; i++) {
            for (int j = cStart; j < cStart + sqrt; j++) {
                if (board[i][j] == num) {
                    return false;
                }
            }
        }
        return true;
    }
    static boolean isValidSudoku(char[][] board) {
        for (int i = 0; i < board.length; i++) {
            for (int j = 0; j < board[i].length; j++) {
                char num = board[i][j];
                if (num != '.') {
                    board[i][j] = '.';
                    if (!isSafe(board, i, j, num)) {
                        board[i][j] = num; 
                        return false;
                    }
                    board[i][j] = num; 
                }
            }
        }
        return true;
    }
}
