// Letter combination of phone number 
public class NumCombinations {
    public static void main(String[] args) {
        pad("","12");
    }

    static void pad(String p, String up){
        if(up.isEmpty()){
            System.out.println(p);
            return;
        }

        int d = up.charAt(0)-'0';

        for(int i = (d-1)*3;i<d*3;i++){
            char ch = (char)('a' + i);
            pad(p+ch, up.substring(1));
        }
    }
}

//return as list

import java.util.ArrayList;

public class NumComList {
    public static void main(String[] args) {
        System.out.println(pad("","12"));
    }

    static ArrayList<String > pad(String p, String up){
        if(up.isEmpty()){
            ArrayList<String > list = new ArrayList<>();
            list.add(p);
            return list;
        }
        ArrayList<String> list = new ArrayList<>();
        int d = up.charAt(0)-'0';

        for(int i = (d-1)*3;i<d*3;i++){
            char ch = (char)('a' + i);
            list.addAll(pad(p+ch, up.substring(1)));
        }
        return list;
    }
}

// return count of the combinations
public class NumComCount {
    public static void main(String[] args) {
        System.out.println(pad("","9"));
    }
    static int pad(String p, String up){
        if(up.isEmpty()){
            return 1;
        }
        int c=0;
        int d = up.charAt(0)-'0';

        for(int i = (d-1)*3;i<d*3;i++){
            char ch = (char)('a' + i);
            c = c+ pad(p+ch, up.substring(1));
        }
        return c;
    }

}
