//SetBitsCount

public class SetBitsCount {
    public static void main(String[] args) {
        int n = 11;
        int m = 10;
        System.out.println(Integer.toBinaryString(m)); // 1010
        int c=0;
        while(n>0){
            if((n&1)==1)
                c++;
            n = n>>1;
        }
        System.out.println(c);
    }
}

//Magic Number 

public class MagicNumber {
    public static void main(String[] args) {
        int n = 6;
        int ans =0;
        int base = 5;
        while(n>0){
            int last = n&1;
            n= n>>1;
            ans+=last*base;
            base*=5;
        }
        System.out.println(ans);
    }
}
